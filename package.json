{
  "name": "notifygram",
  "version": "1.1.0",
  "description": "Lightweight Node.js library for sending application notifications to a Telegram channel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Igor K <igorfordev@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/igorgmail/notifygram.git"
  },
  "homepage": "https://github.com/igorgmail/notifygram#readme",
  "bugs": {
    "url": "https://github.com/igorgmail/notifygram/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "notifygram": "./dist/cli/init.js"
  },
  "files": [
    "dist",
    ".env.example",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --env-file=.env testapp/app.js",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "pack:check": "npm pack --dry-run",
    "test:types": "tsc -p tsconfig.smoke.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "telegram-bot-api",
    "bot",
    "typescript",
    "logger",
    "notifications",
    "monitoring",
    "alerts"
  ],
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
